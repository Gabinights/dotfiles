{
    "layer": "top",
    "position": "top",
    "height": 30,
  "modules-left": [ "cpu", "memory", "sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
  "modules-right": ["mpris", "tray", "pulseaudio", "battery", "custom/power"],

    "mpris": {
      "format": "{player_icon} {title}",
      "format-paused": "{status_icon} <i>{title}</i>",
      "player-icons": {
          "default": "▶",
          "spotify": ""
      },
      "status-icons": {
          "paused": "⏸"
      },
      "ignored-players": ["firefox", "chromium"],
      "max-length": 35,
      "on-click": "/home/gabi/.config/waybar/scripts/spotify_popup.py"
    },
    
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
    },
    "clock": {
        "format": "{:%H:%M}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
    	"calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }	
    },
    "battery": {
    	"states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
	"format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
    "pulseaudio": {
        "format": "{volume}% ",
        "format-muted": ""
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "custom/power": {
      "format": "",
      "tooltip": false,
      "on-click": "/home/gabi/.config/waybar/scripts/toggle_power.sh"
  }
}
