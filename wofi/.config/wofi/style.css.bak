window {
    background-color: rgba(30, 30, 46, 0.9);
    border: 1px solid #89b4fa;
    border-radius: 12px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 14px;
    font-weight: normal;
    box-shadow: none; /* Mata a sombra invisível do GTK que estraga o centro */
}

#input {
    margin: 10px;
    padding: 6px 10px;
    background-color: #11111b;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 8px;
}

#inner-box {
    margin: 0px 8px 8px 8px;
    background-color: transparent;
}

#outer-box {
    background-color: transparent;
}

#scroll {
    margin: 5px 0px;
    border: none;
}

#text {
    color: #cdd6f4;
    margin: 2px;
}

#entry {
    padding: 6px 8px;
    margin: 1px 5px;
    border-radius: 8px;
    background-color: transparent;
    border: 1px solid transparent;
}

#entry:selected {
    background-color: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
}

#entry image {
    margin-right: 12px;
    min-width: 24px;
    min-height: 24px;
}

#entry arrow {
    border: none;
    background: transparent;
}

scrollbar {
    background: transparent;
    border: none;
}

scrollbar slider {
    background: #45475a;
    border-radius: 8px;
    min-width: 6px;
    min-height: 30px;
}

scrollbar slider:hover {
    background: #585b70;
}
